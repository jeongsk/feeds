[{"id":8583,"title":"QA 포트폴리오에는 대부분 어떤 항목을 작성하나요??","content":"2023년 4월, QA 프리온보딩 세션에서 나눴던 많은 질문과 답변 중, \n\"QA 포트폴리오에는 대부분 어떤 항목을 작성하나요??\"... 에 대한 기록입니다. \n비슷한 고민을 하고 계실 QA 엔지니어분들께 도움이 됐으면 하고, 다른 분들의 의견도 기대합니다~!\n\nhttps://www.wanted.co.kr/events/pre_challenge_qa_1","like_count":0,"comment_count":1,"user":{"id":781612,"avatar":"https://static.wanted.co.kr/oneid-user/oBC6tmQJjLMKtiszyDtSkz/Rr933WaZRBz5AiyioaKqHS.jpg","annual":16,"status":1,"is_influencer":false,"job_category":{"id":518,"parent_id":null,"title":"개발","i18n_key":"tag.it2"},"user_hash":"oBC6tmQJjLMKtiszyDtSkz","name":"해피테스터"},"create_time":"2023-04-15T11:07:42","report_count":0,"is_liked":false,"is_commented":false,"is_pinned":false,"pin_type":null,"images":[{"id":2342,"seq":1,"url":"https://static.wanted.co.kr/ImageTargetTypeEnum.COMMUNITY/2023/4/9b7172cb5603e44b499726d19b8dbc3edb5c01fa61a9e0c083bc7e491ef33544"}],"tag_types":[{"id":10354,"title":"QA","i18n_key":"tag.qa","kind":9,"is_visible":true}],"meta_tags":[{"thumbnail_image":"https://static.wanted.co.kr/images/events/2779/04782a8c.jpg","site_type":"website","title":"프리온보딩 QA 챌린지 4월 | 원티드","description":"AI 채용, 연봉 정보, 이력서, 커리어 콘텐츠까지 커리어 성장에 필요한 모든 것, 원티드에서 만나보세요.","site_name":"원티드","origin_url":"https://www.wanted.co.kr/events/pre_challenge_qa_1","favicon":"https://static.wanted.co.kr/favicon/favicon.ico"}],"no":10,"count":3,"rate":0,"isNew":true},{"id":1514,"title":"이력서 제출부터 망했어요...ㅠ","content":"원티드 처음 써봐서 이력서 작성도 엉망으로 한 상태에서 제출을 해버렸네요.....\n망했어요오오오오으아아아악!!!","like_count":11,"comment_count":5,"user":{"id":2251147,"avatar":"https://static.wanted.co.kr/images/avatars/2251147/ea7233dc.jpg","is_influencer":false,"name":"욜로인생"},"create_time":"2021-12-01T21:36:02","report_count":0,"is_liked":false,"is_commented":false,"is_pinned":false,"pin_type":null,"images":[],"tag_types":[{"id":10086,"title":"커리어고민","i18n_key":"tag.keorieo","kind":9,"is_visible":true}],"no":15,"count":1,"rate":0,"isNew":true},{"id":2929,"title":"과연 언제까지 회사를 다니며 돈벌이를 할 수 있을지…","content":"과연 언제까지 회사를 다니며 돈벌이를 할 수 있을지…\n\n안녕하세요! 이제 5년차 되어가는 웹퍼블리셔 입니다.\n년차를 시간이 지나면서 계속 쌓이는데..그만큼의 실력도 비례하게 쌓이지 않는 것 같아 고민입니다.\n개발관련된 업무들은 계속 끊임없이 공부를 하면 발전시켜야 하지만 생각보다 업무하면서 하기엔 벅차네요…\n아예 다른 일로 이직을 할까 하는데 나이들면서 겁만 더 많아지는 듯 합니다… 다들 비슷한 고민과 생각들 많으시지 않나요..?","like_count":10,"comment_count":5,"user":{"id":173778,"avatar":"https://s3.ap-northeast-2.amazonaws.com/wanted-public/profile_default.png","annual":5,"status":1,"is_influencer":false,"job_category":{"id":518,"parent_id":null,"title":"개발","i18n_key":"tag.it2"},"user_hash":"HSBi5RLgyihKLomc5ydF4S","name":"하이안"},"create_time":"2022-02-22T14:50:24","report_count":0,"is_liked":false,"is_commented":false,"is_pinned":false,"pin_type":null,"images":[],"tag_types":[{"id":10086,"title":"커리어고민","i18n_key":"tag.keorieo","kind":9,"is_visible":true}],"meta_tags":null,"no":18,"count":2,"rate":0,"isNew":true},{"id":7384,"title":"👀 데이터 분석 사이드 프로젝트는 어떻게 해야 하나요?","content":"⏰ 450명 넘게 신청한 2022년 마지막 데이터 분석 세미나 오늘 신청마감\n\n1️⃣ “데이터 분석가 커리어를 더 풍부하고 다채롭게” _ 카카오 데이터 분석가 최규민님 인터뷰\n2️⃣ “비전공자 취준생, 데이터 수집부터 분석까지!” _ 광고 중개 플랫폼 비즈니스 분석가 최승아님\n\n“데이터 분석가 커리어: 사이드 프로젝트부터 퍼블릭 스피킹까지” 아직 신청 못하신 분 오늘 꼭 신청하세요.\n12월 세미나 강연 내용 보러가기\n👉 https://bit.ly/3QbtUyB \n\n[ 지금까지 들어온 질문들 ]\n✔️ 비전공자 취업 준비생은 무엇부터 준비하면 될까요? 첫 단추 꿰는 법을 알려주세요!\n✔️ 분석가로 근무하면서 사이드 프로젝트를 하고 싶지만 현실적으로 퇴근 후 시간분배가 어려웠어요, 사이드 프로젝트를 할 때의 시간관리에 관한 노하우나 팁이 있을까요?\n✔️ 개인 프로젝트에 입문하기 위해 Kaggle 등 오픈 된 데이터를 활용해보려고 해도 막히는 부분이 너무 많습니다. 새 프로젝트를 혼자서 도전할 때 너무 막막하고 새롭게 느껴집니다. 혼자 자립할 수 있는 힘을 기르려면 어떤 식으로 공부를 해야할까요?\n✔️ 사이드 프로젝트를 통해 분석 포트폴리오를 만들 때 가장 강조하면 좋을만한 파트가 있을까요?\n✔️ 프로젝트 하시면서 ‘이런 데이터가 재미있었다’,‘이 결과는 의외였다’ 하시는 게 있으셨나요?\n✔️ 혹시 면접을 보셨다면 프로젝트 관련해서 어떤 질문을 받으셨는지 공유해주실 수 있나요?\n\n현직자들의 답변이 궁금하다면, 지금 바로 세미나 신청하기\n👉 https://bit.ly/3QbtUyB","like_count":0,"comment_count":0,"user":{"id":2773855,"avatar":"https://static.wanted.co.kr/oneid-user/eNffJzZZDFUnUKQdAXrcYe/15773a8a7b4e4349ba0a0c28468e1c8d910cb02ad124cccba2680745fa733ed6","annual":3,"status":1,"is_influencer":false,"job_category":{"id":507,"parent_id":null,"titl